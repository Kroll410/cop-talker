# StalkerTalker keys. setup.bat copies this file to .env; paste your values after the =
# Keep .env private: never share or upload it.

# Free key: https://aistudio.google.com/apikey  (NPC replies and speech recognition)
GEMINI_API_KEY=
# Optional, paid: Claude instead of Gemini
ANTHROPIC_API_KEY=
# https://elevenlabs.io -> Developers -> API Keys (give it Text to Speech; Voices Read and User Read are useful)
ELEVENLABS_API_KEY=

# Voice IDs of your ElevenLabs clones (Voices -> your voice -> copy ID). Samples to clone from: see README.
VOICE_HUMAN_01=
VOICE_HUMAN_02=
VOICE_HUMAN_03=
# Optional faction voices; empty ones fall back to the three above
VOICE_HUMAN_01_BANDIT=
VOICE_HUMAN_02_BANDIT=
VOICE_HUMAN_03_BANDIT=
VOICE_FREEDOM_A=
VOICE_FREEDOM_B=
VOICE_MILITARY_A=
VOICE_MILITARY_B=
VOICE_MONOLITH=

# Optional: Twitch chat -> NPCs. Client ID of an app from https://dev.twitch.tv/console/apps (Client Type: Public)
TWITCH_CLIENT_ID=
