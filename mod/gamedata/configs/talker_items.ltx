; StalkerTalker's own item sections. install_mod.ps1 makes configs\external.ltx include this file
; (one line: #include "talker_items.ltx"); uninstall_mod.ps1 takes that line out again.
; Names and descriptions: configs	ext\<language>	alker_items.xml (the game reads every file there).

; Vova Vist's machine gun (Twitch reward): a PKM that fires 100x as fast and does 10x less damage.
; 5000 rounds a belt; while he lives, talker_bridge.script keeps it full, so he never reloads.
[wpn_vova_vist]:wpn_pkm
description             = st_wpn_vova_vist_descr
inv_name                = st_wpn_vova_vist
inv_name_short          = st_wpn_vova_vist
rpm                     = 52500                         ; wpn_pkm: 525
hit_power               = 0.05, 0.05, 0.05, 0.05      ; wpn_pkm: 0.5 each
silencer_hit_power      = 0.055, 0.055, 0.055, 0.055
; never jams and never wears: a PKM loses 0.001 condition a shot, so at 875 shots a second it would be in the
; jamming range (condition under 0.6) in half a second
misfire_start_prob      = 0                             ; wpn_pkm: 0.002
misfire_end_prob        = 0                             ; wpn_pkm: 0.03
condition_shot_dec      = 0                             ; wpn_pkm: 0.001
condition_queue_shot_dec = 0                            ; wpn_pkm: 0.0012
ammo_mag_size           = 5000
ammo_elapsed            = 5000
cost                    = 500                           ; a toy, not a 20000 loot prize

; Vova Vist himself: an ordinary army soldier (the same keys as sim_default_military_2, which the game reads only after
; this file, so it can't be the parent) who never lets go of the trigger: a stock soldier fires a machine gun in bursts
; of 1-6 with 1-4 s pauses, which at 52500 rpm is a few hundredths of a second of fire. The engine reads these from the
; man's own section.
[talker_vova_soldier]:stalker
character_profile       = sim_default_military_2
spec_rank               = experienced
community               = military
auto_min_queue_size_far         = 5000
auto_max_queue_size_far         = 5000
auto_min_queue_interval_far     = 50
auto_max_queue_interval_far     = 150
auto_min_queue_size_medium      = 5000
auto_max_queue_size_medium      = 5000
auto_min_queue_interval_medium  = 50
auto_max_queue_interval_medium  = 150
auto_min_queue_size_close       = 5000
auto_max_queue_size_close       = 5000
auto_min_queue_interval_close   = 50
auto_max_queue_interval_close   = 150
mchg_min_queue_size_far         = 5000
mchg_max_queue_size_far         = 5000
mchg_min_queue_interval_far     = 50
mchg_max_queue_interval_far     = 150
mchg_min_queue_size_medium      = 5000
mchg_max_queue_size_medium      = 5000
mchg_min_queue_interval_medium  = 50
mchg_max_queue_interval_medium  = 150
mchg_min_queue_size_close       = 5000
mchg_max_queue_size_close       = 5000
mchg_min_queue_interval_close   = 50
mchg_max_queue_interval_close   = 150
