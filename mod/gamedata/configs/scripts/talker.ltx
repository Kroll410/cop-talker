; StalkerTalker keys. Names are the game's DIK_ key names (DIK_T, DIK_Y, DIK_F5, DIK_LMENU = left Alt...).
; Put "none" to turn a key off. Restart the game (or load a save) after changing this file.
[keys]
talk   = DIK_T   ; hold and speak to the nearest / looked-at stalker
follow = DIK_Y   ; the stalker you look at (or the nearest) follows you, no talking needed
stay   = DIK_U   ; he stops following and goes back to his business
