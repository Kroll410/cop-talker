-- StalkerTalker bridge: shares game state with the companion app through files
-- in <game root>\talker\ and shows the AI replies in game.
--   state.json   - rewritten twice a second: actor, level, time, nearby NPCs
--   events.jsonl - appended: deaths, hits, player using an NPC
--   inbox.txt    - written by the companion: "say|<npc_id>|<text>" lines; read and deleted here
-- Every entry point is called through pcall from the hooks, so a bug here never crashes the game.

MOD_VERSION = 15  -- the companion app checks this, so a game still running an old copy of this script is noticed
local dir = nil
local next_state_write = 0
local next_inbox_check = 0
local hit_cooldown = {}

local function path(name)
	if not dir then
		local ok, p = pcall(function() return getFS():update_path("$fs_root$", "talker\\") end)
		dir = (ok and p) or "talker\\"  -- the installer creates this folder
	end
	return dir .. name
end

-- forward declarations (defined further down, used by npc_info)
local emission_active, in_cover, append_event
local stock_cache = {}  -- what NPCs carry, cached (filled further down)
local followers = {}

local function log_error(msg)
	local f = io.open(path("bridge_errors.log"), "a")
	if f then f:write(os.date("%H:%M:%S ") .. tostring(msg) .. "\n"); f:close() end
end

-- ------------------------------------------------------------- JSON
local function esc(s)
	s = tostring(s)
	s = string.gsub(s, '[%c"\\]', function(c)
		if c == '"' then return '\\"' elseif c == "\\" then return "\\\\"
		elseif c == "\n" then return "\\n" elseif c == "\r" then return "" elseif c == "\t" then return " " end
		return ""
	end)
	return s
end

local function to_json(v)
	local t = type(v)
	if t == "table" then
		if v.__array or v[1] ~= nil then
			local out = {}
			for i = 1, #v do out[i] = to_json(v[i]) end
			return "[" .. table.concat(out, ",") .. "]"
		end
		local out = {}
		for k, val in pairs(v) do
			if k ~= "__array" then table.insert(out, '"' .. esc(k) .. '":' .. to_json(val)) end
		end
		return "{" .. table.concat(out, ",") .. "}"
	elseif t == "string" then
		return '"' .. esc(v) .. '"'
	elseif t == "number" then
		if v == math.floor(v) then return string.format("%d", v) end
		return string.format("%.3f", v)
	elseif t == "boolean" then
		return v and "true" or "false"
	end
	return "null"
end

-- ------------------------------------------------------------- object info
local function relation_name(npc)
	local r = npc:relation(db.actor)
	if r == game_object.enemy then return "enemy" elseif r == game_object.friend then return "friend" end
	return "neutral"
end

local function weapon_of(obj)
	local item = obj:active_item()
	return item and item:section() or nil
end

local function npc_info(npc)
	if not npc then return nil end
	local info = { id = npc:id(), name = npc:character_name(), community = npc:character_community(),
		rank = npc:character_rank(), story_name = npc:name(), alive = npc:alive(),
		health = npc.health, relation = relation_name(npc), weapon = weapon_of(npc),
		dist = npc:position():distance_to(db.actor:position()) }
	local pos = npc:position()  -- rough map position: who could have seen what happened (whole metres)
	info.x, info.z = math.floor(pos.x + 0.5), math.floor(pos.z + 0.5)
	local ok, prefix = pcall(function() return npc:sound_prefix() end)
	if ok then info.voice = prefix end
	local enemy = npc:best_enemy()
	info.in_combat = enemy ~= nil
	if enemy then info.fighting = enemy:id() == db.actor:id() and "player" or enemy:name() end
	local okw, wounded = pcall(function() return xr_wounded.is_wounded(npc) end)
	if okw then info.wounded = wounded and true or false end
	local okg, gw = pcall(function() return relation_registry.community_goodwill(npc:character_community(), db.actor:id()) end)
	if okg then info.goodwill = gw end
	local okp, place = pcall(function()
		local se = alife():object(npc:id())
		if se and se.m_smart_terrain_id ~= 65535 then
			return smart_names.get_smart_terrain_name(alife():object(se.m_smart_terrain_id))
		end
	end)
	if okp and place then info.place = place end
	local oks, story = pcall(function() return get_object_story_id(npc:id()) end)
	info.story = (oks and story ~= nil) and true or false
	if emission_active() then info.sheltered = in_cover(npc:position()) end
	info.following = followers[npc:id()] or false
	local okq, squad = pcall(function() return get_object_squad(npc) end)
	if okq and squad then
		info.squad = squad.id
		info.leader = squad:commander_id() == npc:id()
	end
	return info
end

local function mutant_info(obj, apos)
	return { id = obj:id(), kind = obj:section(), dist = obj:position():distance_to(apos), health = obj.health }
end

function emission_active()
	local ok, started = pcall(function() return surge_manager.get_surge_manager().started end)
	return ok and started and true or false
end

-- Inside one of the game's emission shelters? The surge manager's own cover list is often empty
-- (it's built before the zones exist), so read the shelter names from its config ourselves.
local cover_names = nil
function in_cover(pos)
	local ok, inside = pcall(function()
		if not cover_names then
			cover_names = {}
			local ini = ini_file("misc\\surge_manager.ltx")
			for i = 0, ini:line_count("list") - 1 do
				local _, id = ini:r_line("list", i, "", "")
				table.insert(cover_names, id)
			end
		end
		for _, name in ipairs(cover_names) do
			local zone = db.zone_by_name[name]
			if zone and zone:inside(pos) then return true end
		end
		return false
	end)
	if not ok then log_error("in_cover: " .. tostring(inside)) end
	return ok and inside or false
end

-- ------------------------------------------------------------- follow the player
-- Uses the game's own companion scheme (xr_companion); "stay" hands the NPC back to its normal logic.

local function start_follow(npc)
	local ini = ini_file("scripts\\talker_follow.ltx")
	xr_logic.configure_schemes(npc, ini, "scripts\\talker_follow.ltx", modules.stype_stalker, "logic", "")
	xr_logic.activate_by_section(npc, ini, "companion@talker", "", false)
	followers[npc:id()] = true
end

local function stop_follow(npc)
	if not followers[npc:id()] then return end
	followers[npc:id()] = nil
	xr_logic.initialize_obj(npc, db.storage[npc:id()], false, db.actor, modules.stype_stalker)
end

-- ------------------------------------------------------------- emotes, contracts, money
-- Emotes play one of the game's own animation states for a few seconds, then hand the NPC back to his logic.
local EMOTES = { hello = "hello", salute = "salut", threat = "threat", punch = "punch", hands_up = "hands_up",
	fold_arms = "fold_arms", sit = "sit_ass", refuse = "refuse", claim = "claim", backoff = "backoff",
	guitar = "play_guitar", harmonica = "play_harmonica", binocular = "binocular", pain = "psy_pain" }
local LONG_EMOTES = { sit = 20000, guitar = 20000, harmonica = 20000 }
local emotes = {}

local looks = {}  -- looks[npc id] = { target = id, till = ms }: who he faces while he talks

local function look_target(npc)
	local l = looks[npc:id()]
	local obj = l and level.object_by_id(l.target)
	return (obj and obj:alive()) and obj or db.actor
end

local function play_emote(npc, name)
	local state = EMOTES[name]
	if not state then return false, "unknown gesture" end
	if npc:best_enemy() then return false, "he is fighting" end
	local okw, wounded = pcall(function() return xr_wounded.is_wounded(npc) end)
	if okw and wounded then return false, "he is wounded" end
	local id = npc:id()
	local prev = emotes[id] and emotes[id].prev or state_mgr.get_state(npc)
	state_mgr.set_state(npc, state, nil, nil, { look_object = look_target(npc) }, { fast_set = true })
	emotes[id] = { till = time_global() + (LONG_EMOTES[name] or 4500), prev = prev, state = state }
	return true
end

local function update_emotes()
	local now = time_global()
	for id, e in pairs(emotes) do
		local npc = level.object_by_id(id)
		if not npc or not npc:alive() or npc:best_enemy() then
			emotes[id] = nil
		elseif now > e.till then
			emotes[id] = nil
			pcall(state_mgr.set_state, npc, e.prev or "idle", nil, nil, nil, { fast_set = true })
		elseif state_mgr.get_state(npc) ~= e.state then  -- his logic took over too early: keep it going
			pcall(state_mgr.set_state, npc, e.state, nil, nil, { look_object = look_target(npc) })
		end
	end
end

-- "look:<id>:<seconds>": while he talks to another man (or listens to him), he turns to face him, in whatever
-- pose he is in; then his own logic takes over again. Never during a fight.
local function look_at(npc, arg)
	local target_id, seconds = string.match(arg or "", "^(%d+):?(%d*)$")
	local target = target_id and level.object_by_id(tonumber(target_id))
	if not target or not target:alive() or target:id() == npc:id() then return false, "nobody to look at" end
	if npc:best_enemy() then return false, "he is fighting" end
	local okw, wounded = pcall(function() return xr_wounded.is_wounded(npc) end)
	if okw and wounded then return false, "he is wounded" end
	local ms = math.max(2, math.min(30, tonumber(seconds) or 6)) * 1000
	looks[npc:id()] = { target = target:id(), till = time_global() + ms }
	if not emotes[npc:id()] then  -- a gesture going on keeps its pose and just turns to him
		state_mgr.set_state(npc, state_mgr.get_state(npc), nil, nil, { look_object = target })
	end
	return true
end

local function update_looks()
	local now = time_global()
	for id, l in pairs(looks) do
		local npc = level.object_by_id(id)
		local target = level.object_by_id(l.target)
		if not npc or not npc:alive() or npc:best_enemy() then
			looks[id] = nil
		elseif now > l.till or not target or not target:alive() then
			looks[id] = nil
			if not emotes[id] then  -- let his own logic choose where to look again
				pcall(state_mgr.set_state, npc, state_mgr.get_state(npc), nil, nil, nil)
			end
		elseif not emotes[id] then  -- his logic turned him away: face the man again
			local st = db.storage[id] and db.storage[id].state_mgr
			if st and st.look_object ~= l.target then
				pcall(state_mgr.set_state, npc, state_mgr.get_state(npc), nil, nil, { look_object = target })
			end
		end
	end
end

local contracts = {}  -- contracts[killer id] = { target = id, since = ms, ... }, until the job is over
local grudges = {}    -- grudges[a][b] = true: a fights b, even where a base forbids fighting

-- xr_combat_ignore asks this, so a base's "no fighting" rule lets agreed fights through.
function is_contract(obj, enemy)
	if not obj or not enemy then return false end
	local a, b = grudges[obj:id()], grudges[enemy:id()]
	return (a and a[enemy:id()]) or (b and b[obj:id()]) or false
end

-- a becomes b's enemy the way the game itself does it (set_squads_enemies): relation on the online object,
-- goodwill on the A-Life one so the simulation doesn't undo it, and he is told where b is.
local function add_grudge(a, b)
	if not a or not b or not a:alive() or a:id() == b:id() then return end
	grudges[a:id()] = grudges[a:id()] or {}
	grudges[a:id()][b:id()] = true
	pcall(function() a:set_relation(game_object.enemy, b) end)
	pcall(function() a:force_set_goodwill(-5000, b) end)
	pcall(function() alife():object(a:id()):force_set_goodwill(-5000, b:id()) end)
	pcall(function() a:make_object_visible_somewhen(b) end)
end

-- Makes one man neutral to the player, the way the game's quests do it (game_relations.set_npcs_relation:
-- personal goodwill). For a faction that hates the player (bandits) goodwill 0 may still leave him an enemy,
-- so it goes up step by step until the game no longer counts the player as his enemy. Returns true if so.
local function make_neutral(obj)
	if grudges[obj:id()] then grudges[obj:id()][db.actor:id()] = nil end
	pcall(function() obj:set_relation(game_object.neutral, db.actor) end)
	for _, goodwill in ipairs({ 0, 300, 600, 1000, 1500 }) do
		if obj:relation(db.actor) ~= game_object.enemy then break end
		pcall(function() obj:force_set_goodwill(goodwill, db.actor) end)
		pcall(function() alife():object(obj:id()):force_set_goodwill(goodwill, db.actor:id()) end)
	end
	return obj:relation(db.actor) ~= game_object.enemy
end

local calm_squad  -- defined below squad_mates

local function squad_mates(npc)
	local mates = {}
	pcall(function()
		local squad = get_object_squad(npc)
		if not squad then return end
		for k in squad:squad_members() do
			local obj = db.storage[k.id] and db.storage[k.id].object
			if obj and obj:alive() and obj:id() ~= npc:id() then table.insert(mates, obj) end
		end
	end)
	return mates
end

-- He and everyone in his squad (the ones near and the ones off-screen) stop fighting the player.
calm_squad = function(npc)
	local done = make_neutral(npc)
	for _, mate in ipairs(squad_mates(npc)) do
		pcall(make_neutral, mate)
	end
	pcall(function()  -- squad members not loaded right now: their A-Life goodwill, like the game's squads
		for k in get_object_squad(npc):squad_members() do
			if not (db.storage[k.id] and db.storage[k.id].object) then
				alife():object(k.id):force_set_goodwill(1000, db.actor:id())
			end
		end
	end)
	return done
end

-- A fight between two men: both hate each other, and the target's squad stands by him.
local function start_feud(killer, target)
	add_grudge(killer, target)
	add_grudge(target, killer)
	for _, mate in ipairs(squad_mates(target)) do
		add_grudge(mate, killer)
		add_grudge(killer, mate)
	end
end

-- A paid hit. The target may be anywhere on this level, also far away or offline: then the killer's squad
-- hunts the target's squad with the game's own "attack a squad" move (hooked in sim_squad_scripted,
-- sim_squad_actions, xr_reach_task); when both are online, they simply fight. If both are offline (far from
-- the player) and meet, the hit happens off-screen.
local HUNT_GIVE_UP = 15 * 60 * 1000  -- ms of real time before the killer gives up
local hunts = {}  -- killer squad id -> target squad id, while a squad is out hunting

-- The hooks in the game's squad scripts ask this.
function is_hunting(squad)
	return squad ~= nil and hunts[squad.id] ~= nil and squad.assigned_target_id == hunts[squad.id]
end

local function squad_of(id)
	local se = alife():object(id)
	return se and se.group_id and se.group_id ~= 65535 and alife():object(se.group_id) or nil
end

local function send_hunting(killer_id, target_id)
	local squad, target_squad = squad_of(killer_id), squad_of(target_id)
	if not squad or not target_squad or squad.id == target_squad.id then return false end
	hunts[squad.id] = target_squad.id
	if squad.assigned_target_id == target_squad.id and squad.current_action
			and squad.current_action.name == "reach_target" then
		return true
	end
	if squad.current_action then pcall(function() squad.current_action:finalize() end) end
	squad.assigned_target_id = target_squad.id
	squad.current_target_id = nil
	squad.current_action = sim_squad_actions.reach_target(squad)
	squad.current_action:make(false)
	return true
end

local function stop_hunting(killer_id)
	local squad = squad_of(killer_id)
	if squad and hunts[squad.id] then
		hunts[squad.id] = nil
		squad.current_action = nil
		squad:clear_assigned_target()  -- the simulation picks his next job by itself
	end
end

local function se_alive(se)
	if not se then return false end
	local ok, alive = pcall(function() return se:alive() end)
	return ok and alive
end

local function contract_kill(npc, target_id)
	if not target_id or target_id == npc:id() then return false end
	local se = alife():object(target_id)
	if not se_alive(se) then return false end
	local ok, story = pcall(function() return get_object_story_id(target_id) end)
	if ok and story ~= nil then return false end  -- quest people are off limits
	pcall(stop_follow, npc)
	contracts[npc:id()] = { target = target_id, since = time_global(), next_look = 0 }
	local target = level.object_by_id(target_id)
	if target and target:alive() and target:position():distance_to(npc:position()) < 60 then
		start_feud(npc, target)  -- he's right here: straight to the fight
	else
		pcall(function() alife():object(npc:id()):force_set_goodwill(-5000, target_id) end)
		local okh, sent = pcall(send_hunting, npc:id(), target_id)
		if not (okh and sent) then log_error("hunt: " .. tostring(sent)) end
	end
	return true
end

-- Shot by a man he has a feud with: renew it (the game may have reset relations) and call in his squad.
local function on_feud_hit(victim, who)
	if not is_contract(victim, who) then return end
	start_feud(who, victim)
end

local function contract_over(killer_id, c, dead, why)
	contracts[killer_id] = nil
	pcall(stop_hunting, killer_id)
	append_event({ type = "contract_over", killer = killer_id, target = c.target, target_dead = dead, reason = why })
end

local function update_contract(killer_id, c, now)
	local se_killer, se_target = alife():object(killer_id), alife():object(c.target)
	if not se_alive(se_target) then return contract_over(killer_id, c, true) end
	if not se_alive(se_killer) then return contract_over(killer_id, c, false, "killer died") end
	if now - c.since > HUNT_GIVE_UP then return contract_over(killer_id, c, false, "gave up") end
	local killer, target = level.object_by_id(killer_id), level.object_by_id(c.target)
	if killer and target then
		-- both online: once he's close, the feud starts; keep telling him where the target is
		if now >= c.next_look then
			c.next_look = now + 2000
			if killer:position():distance_to(target:position()) < 80 or c.feud then
				if not c.feud then c.feud = true; start_feud(killer, target) end
				add_grudge(killer, target)
				pcall(function() killer:make_object_visible_somewhen(target) end)
			else
				pcall(send_hunting, killer_id, c.target)
			end
		end
	elseif not killer and not target then
		-- both far from the player: when the squads meet, the hit happens off-screen
		if se_killer.position:distance_to(se_target.position) < 30 then
			local done = pcall(function() alife():kill_entity(se_target) end)
			if not done then pcall(function() alife():release(se_target, true) end) end
			return contract_over(killer_id, c, true, "off-screen")
		end
		if now >= c.next_look then c.next_look = now + 5000; pcall(send_hunting, killer_id, c.target) end
	elseif now >= c.next_look then
		c.next_look = now + 3000
		pcall(send_hunting, killer_id, c.target)  -- one of them is out of reach: keep walking
	end
end

local next_contract_check = 0
local function update_contracts()
	local now = time_global()
	if now < next_contract_check then return end
	next_contract_check = now + 500
	for killer_id, c in pairs(contracts) do
		local ok, err = pcall(update_contract, killer_id, c, now)
		if not ok then log_error("contract: " .. tostring(err)) end
	end
	for id in pairs(grudges) do  -- forget the dead
		local obj = level.object_by_id(id)
		if not obj or not obj:alive() then grudges[id] = nil end
	end
end

-- Stalkers on this level that aren't in the 40 m list: a hit can be ordered on them too.
local far_cache = { at = 0, list = nil }
local function far_stalkers(near)
	local now = time_global()
	if far_cache.list and now < far_cache.at then return far_cache.list end
	local apos, list = db.actor:position(), {}
	local level_id = game_graph():vertex(alife():actor().m_game_vertex_id):level_id()
	for id, squad in pairs(sim_board.get_sim_board().squads) do
		if game_graph():vertex(squad.m_game_vertex_id):level_id() == level_id then
			for k in squad:squad_members() do
				local se = alife():object(k.id)
				if se and not near[k.id] and se_alive(se) and IsStalker(nil, se:clsid()) then
					local okn, info = pcall(function()
						local story = get_object_story_id(k.id)
						return { id = k.id, name = se:character_name(), community = se:community(),
							dist = math.floor(se.position:distance_to(apos)), online = se.online and true or false,
							story = story ~= nil or nil }
					end)
					if okn and info and info.name and info.name ~= "" then table.insert(list, info) end
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	local out = { __array = true }
	for i = 1, math.min(#list, 60) do out[i] = list[i] end
	far_cache = { at = now + 5000, list = out }
	return out
end

-- Mouth moving while the AI voice speaks: the NPC plays a silent "talk" sound (gamedata\sounds\talker\mouth_N.ogg,
-- N seconds long) and the engine animates his head and mouth by itself, like with the game's own voice lines.
-- The registered sound id is kept in the NPC's db.storage table: the game makes that table anew whenever he
-- spawns again (went offline and came back), which is exactly when the clips must be registered again.
-- (Comparing game objects with == fails in this engine: "No such operator defined".)
local mouth = {}  -- fallback by npc id, for an NPC without db.storage
local next_mouth_id = 9100

local function new_sound_id()
	local ok, id = pcall(function() return sound_theme.id() end)
	if ok and type(id) == "number" then return id end
	next_mouth_id = next_mouth_id + 1
	return next_mouth_id
end

local function talk_mouth(npc, seconds)
	local st = db.storage[npc:id()]
	local holder = st or mouth
	local key = st and "talker_mouth_id" or npc:id()
	local id = holder[key]
	if id == nil then  -- first time on this spawn of him: register the clips
		local prefix = npc:sound_prefix()
		npc:sound_prefix("")
		id = new_sound_id()
		local ok, count = pcall(function() return npc:add_sound("talker\\mouth_", 64, snd_type.talk, 2, 1, id) end)
		npc:sound_prefix(prefix)
		if not ok or not count or count <= 0 then
			log_error("mouth: add_sound failed for " .. npc:name() .. ": " .. tostring(count))
			id = false
		end
		holder[key] = id
	end
	if not id then return false end
	local n = math.max(1, math.min(20, math.floor((tonumber(seconds) or 3) + 0.5)))
	npc:play_sound(id, 0.01, 0, 1, 0, n - 1)
	return true
end

-- He hands you one item he really has (a deal agreed in conversation), with the game's "item received" notice.
local function give_item(npc, section)
	local item = npc:object(section)
	if not item then return false end
	npc:transfer_item(item, db.actor)
	stock_cache[npc:id()] = nil
	pcall(news_manager.relocate_item, db.actor, "in", section)
	return true
end

-- The game's own "money given / received" notice: coupons icon, amount, and the PDA sound.
local function money_news(direction, amount)
	pcall(news_manager.relocate_money, db.actor, direction, amount)
	pcall(xr_sound.set_sound_play, db.actor:id(), "pda_tips")
end

local last_take_ok = {}  -- npc id -> did the player's last payment to him go through

local function money_action(npc, kind, amount)
	amount = math.floor(tonumber(amount) or 0)
	if kind == "take" then last_take_ok[npc:id()] = false end  -- a refused payment never leaves an old "ok" behind
	if amount <= 0 or amount > 100000 then return false end
	if kind == "take" then
		local ok = db.actor:money() >= amount
		last_take_ok[npc:id()] = ok  -- goods and hits marked ":paid" happen only if this went through
		if not ok then return false end
		db.actor:transfer_money(amount, npc)  -- you pay him
		money_news("out", amount)
		return true
	elseif kind == "give" then
		amount = math.min(amount, npc:money())  -- out of his own pocket: no money from nowhere
		if amount <= 0 then return false end
		npc:transfer_money(amount, db.actor)  -- he pays you
		money_news("in", amount)
		return true
	end
	return false
end

-- Actions decided by the AI. Story NPCs only do emotes and money, so quests can't break.
local function do_action(npc_id, action)
	local npc = npc_id and level.object_by_id(npc_id)
	if not npc or not npc:alive() or not db.actor then return end
	local kind, arg = string.match(action, "^(%w+):(.+)$")
	-- "item:medkit:paid", "kill:123:paid": only if the payment just before it really went through
	if arg and string.sub(arg, -5) == ":paid" then
		arg = string.sub(arg, 1, -6)
		if not last_take_ok[npc:id()] then
			append_event({ type = "act_done", action = action, ok = false, reason = "not paid" })
			return
		end
	end
	if kind == "emote" then
		local ok, done, why = pcall(play_emote, npc, arg)
		append_event({ type = "act_done", action = action, ok = (ok and done) and true or false,
			reason = (not ok) and tostring(done) or why })
		return
	end
	if kind == "mouth" then return talk_mouth(npc, arg) end
	if kind == "look" then
		local ok, err = pcall(look_at, npc, arg)
		if not ok then log_error("look: " .. tostring(err)) end
		return
	end
	if kind == "paidby" then  -- another NPC pays him for the job (money moves between them, never yours)
		local from_id, amount = string.match(arg, "^(%d+):(%d+)$")
		local payer = from_id and level.object_by_id(tonumber(from_id))
		local done = false
		if payer and payer:alive() then
			amount = math.min(tonumber(amount), payer:money())
			if amount > 0 then payer:transfer_money(amount, npc); done = true end
		end
		append_event({ type = "act_done", action = action, ok = done })
		return
	end
	if kind == "item" then
		local done = give_item(npc, arg)
		append_event({ type = "act_done", action = action, ok = done and true or false })
		return
	end
	if kind == "buy" then  -- "buy:medkit:300": he buys your item and pays you
		local done, why = buy_from_actor(npc, arg)
		append_event({ type = "act_done", action = action, ok = done and true or false, reason = why,
			money = db.actor:money() })
		return
	end
	if kind == "take" or kind == "give" then
		local done = money_action(npc, kind, arg)
		append_event({ type = "act_done", action = action, ok = done and true or false, money = db.actor:money() })
		return
	end
	local ok, story = pcall(function() return get_object_story_id(npc_id) end)
	if ok and story ~= nil then return end
	if kind == "kill" then
		local done = contract_kill(npc, tonumber(arg))
		append_event({ type = "act_done", action = action, ok = done and true or false })
		return
	end
	if action == "hostile" then
		pcall(stop_follow, npc)
		npc:set_relation(game_object.enemy, db.actor)
		add_grudge(npc, db.actor)  -- he really opens fire, even inside a base
		pcall(function() npc:make_object_visible_somewhen(db.actor) end)
	elseif action == "follow" then
		local okf, err = pcall(start_follow, npc)
		if not okf then log_error("follow: " .. tostring(err)) end
	elseif action == "stay" then
		local oks2, err = pcall(stop_follow, npc)
		if not oks2 then log_error("stay: " .. tostring(err)) end
	elseif action == "calm" then  -- talked down or bribed: he and his whole squad stop fighting you
		local done = calm_squad(npc)
		append_event({ type = "act_done", action = action, ok = done })
	elseif action == "friend" then
		if grudges[npc:id()] then grudges[npc:id()][db.actor:id()] = nil end
		npc:set_relation(game_object.friend, db.actor)
	end
end

local function outfit_of(obj)
	local ok, outfit = pcall(function() return obj:get_current_outfit() end)
	return ok and outfit and outfit:section() or nil
end

local function is_stalker(obj)
	return obj and IsStalker(obj) and obj:id() ~= db.actor:id()
end

function append_event(ev)  -- forward-declared local (used by actions above)
	ev.t = time_global()
	ev.level = level.name()
	local f = io.open(path("events.jsonl"), "a")
	if f then f:write(to_json(ev) .. "\n"); f:close() end
end

-- ------------------------------------------------------------- tasks and trade (for quest/trade talk)
local function item_title(sec)
	local ok, name = pcall(function() return game.translate_string(system_ini():r_string(sec, "inv_name")) end)
	return ok and name or nil
end

local tasks_cache, tasks_at = nil, 0
local function active_tasks()
	local now = time_global()
	if tasks_cache and now < tasks_at then return tasks_cache end
	local list = { __array = true }
	pcall(function()
		for _, t in pairs(task_manager.get_task_manager().task_info) do
			local title = t.current_title and game.translate_string(t.current_title)
			if title and title ~= "" then
				table.insert(list, (t.status == "selected" and "* " or "") .. title)
			end
		end
	end)
	tasks_cache, tasks_at = list, now + 5000
	return list
end

-- What a trader has on him: names, count and base price. Cached, it doesn't change every second.
local function trader_stock(npc)
	local id, now = npc:id(), time_global()
	local c = stock_cache[id]
	if c and now < c.at then return c.list end
	local counts, order = {}, {}
	npc:iterate_inventory(function(_, item)
		local sec = item:section()
		if not counts[sec] then counts[sec] = 0; table.insert(order, sec) end
		counts[sec] = counts[sec] + 1
	end, npc)
	local list = { __array = true }
	for _, sec in ipairs(order) do
		if #list >= 30 then break end
		local name = item_title(sec)
		if name and name ~= "" then
			local okc, cost = pcall(function() return system_ini():r_u32(sec, "cost") end)
			table.insert(list, name .. " x" .. counts[sec] .. ((okc and cost) and (" ~" .. cost) or "") .. " #" .. sec)
		end
	end
	stock_cache[id] = { at = now + 20000, list = list }
	return list
end

-- What the player could sell: his backpack, without what he wears or holds in a slot, quest items, PDA and bolts.
local NOT_FOR_SALE = { bolt = true, device_pda = true, device_torch = true, wpn_binoc = false }
local actor_stock_cache = nil

local function equipped_ids(actor)
	local ids = {}
	for slot = 0, 12 do
		local ok, item = pcall(function() return actor:item_in_slot(slot) end)
		if ok and item then ids[item:id()] = true end
	end
	local ok, outfit = pcall(function() return actor:get_current_outfit() end)
	if ok and outfit then ids[outfit:id()] = true end
	local active = actor:active_item()
	if active then ids[active:id()] = true end
	return ids
end

local function sellable(actor, item, equipped)
	local sec = item:section()
	if NOT_FOR_SALE[sec] or equipped[item:id()] then return false end
	local okq, quest = pcall(function()
		local ini = system_ini()
		return ini:line_exist(sec, "quest_item") and ini:r_bool(sec, "quest_item")
	end)
	return not (okq and quest)
end

local function actor_stock()
	local now = time_global()
	if actor_stock_cache and now < actor_stock_cache.at then return actor_stock_cache.list end
	local actor = db.actor
	local equipped = equipped_ids(actor)
	local counts, order = {}, {}
	actor:iterate_inventory(function(_, item)
		if not sellable(actor, item, equipped) then return end
		local sec = item:section()
		if not counts[sec] then counts[sec] = 0; table.insert(order, sec) end
		counts[sec] = counts[sec] + 1
	end, actor)
	local list = { __array = true }
	for _, sec in ipairs(order) do
		if #list >= 30 then break end
		local name = item_title(sec)
		if name and name ~= "" then
			local okc, cost = pcall(function() return system_ini():r_u32(sec, "cost") end)
			table.insert(list, name .. " x" .. counts[sec] .. ((okc and cost) and (" ~" .. cost) or "") .. " #" .. sec)
		end
	end
	actor_stock_cache = { at = now + 3000, list = list }
	return list
end

local function safe_actor_stock()
	local ok, list = pcall(actor_stock)
	if ok then return list end
	log_error("actor_stock: " .. tostring(list))
	return nil
end

local trading_near = false  -- someone who could trade is standing next to the player (set by write_state)

-- He buys one item from the player: the item and the money move together, or nothing happens.
function buy_from_actor(npc, arg)
	local section, price = string.match(arg or "", "^(.+):(%d+)$")
	price = tonumber(price)
	if not section or not price or price <= 0 or price > 100000 then return false, "bad deal" end
	local actor = db.actor
	local equipped, found = equipped_ids(actor), nil
	actor:iterate_inventory(function(_, item)
		if not found and item:section() == section and sellable(actor, item, equipped) then found = item end
	end, actor)
	if not found then return false, "player has no " .. section end
	if npc:money() < price then return false, "npc has only " .. npc:money() end
	actor:transfer_item(found, npc)
	npc:transfer_money(price, actor)
	actor_stock_cache, stock_cache[npc:id()] = nil, nil
	pcall(news_manager.relocate_item, actor, "out", section)
	money_news("in", price)
	return true
end

local function sells(npc, info)
	if info.community == "trader" then return true end
	if not info.story then return false end
	local ok, on = pcall(function() return npc:is_trade_enabled() end)
	return ok and on
end

-- ------------------------------------------------------------- state
local function link_ids()  -- NPCs that show a viewer label now (the app re-sends any it misses)
	local ids = { __array = true }
	for id in pairs(twitch_links or {}) do table.insert(ids, id) end
	return ids
end

local function write_state()
	local actor = db.actor
	local apos = actor:position()
	local npcs = { __array = true }
	local mutants = { __array = true }
	trading_near = false
	for id, st in pairs(db.storage) do
		local obj = level.object_by_id(id)
		if is_stalker(obj) and obj:alive() then
			local d = obj:position():distance_to(apos)
			if d < 40 then
				local info = npc_info(obj)
				if (d < 6 and sells(obj, info)) or d < 4 then  -- traders, and anyone you stand next to
					local okt, stock = pcall(trader_stock, obj)
					if okt then info.stock = stock end
					local okm, money = pcall(function() return obj:money() end)
					if okm then info.money = money end  -- what he could pay you for your goods
					trading_near = true
				end
				table.insert(npcs, info)
			end
		elseif obj and IsMonster(obj) and obj:alive() then
			local d = obj:position():distance_to(apos)
			if d < 50 then table.insert(mutants, mutant_info(obj, apos)) end
		end
	end
	table.sort(npcs, function(a, b) return a.dist < b.dist end)
	while #npcs > 10 do table.remove(npcs) end
	table.sort(mutants, function(a, b) return a.dist < b.dist end)
	while #mutants > 6 do table.remove(mutants) end
	local near = {}
	for _, n in ipairs(npcs) do near[n.id] = true end
	local okf, far_list = pcall(far_stalkers, near)
	if not okf then log_error("far: " .. tostring(far_list)); far_list = nil end

	local target = level.get_target_obj and level.get_target_obj()
	local state = {
		t = time_global(), level = level.name(), mod_version = MOD_VERSION, twitch_links = link_ids(),
		hours = level.get_time_hours(), minutes = level.get_time_minutes(),
		weather = level.get_weather(), emission = emission_active(),
		actor_sheltered = emission_active() and in_cover(actor:position()) or nil,
		actor = { name = actor:character_name(), health = actor.health, money = actor:money(),
			weapon = weapon_of(actor), outfit = outfit_of(actor), talking = actor:is_talking(),
			stock = trading_near and safe_actor_stock() or nil },  -- only next to someone who could buy
		target_id = (target and is_stalker(target)) and target:id() or nil,
		npcs = npcs,
		far = far_list,
		mutants = mutants,
		tasks = active_tasks(),
	}
	local tmp = path("state.tmp")
	local f = io.open(tmp, "w")
	if f then
		f:write(to_json(state)); f:close()
		os.remove(path("state.json"))
		os.rename(tmp, path("state.json"))
	end
end

-- ------------------------------------------------------------- on-screen lines
-- Bottom status line (listening / thinking) and subtitles, in HUD slots the single-player game leaves free.
local STATUS_SLOT = "mp_pressjump"
local SUB_SLOT = "cs_subtitles"
local LISTEN_TEXT = string.char(209, 235, 243, 245, 224, 254, 46, 46, 46)  -- "listening..." in cp1251 Ukrainian
local THINK_TEXT = string.char(196, 243, 236, 224, 186, 46, 46, 46)        -- "thinking..."
local status_until, sub_until = 0, 0
-- Twitch viewers linked to NPCs: looking at one shows "Name [nickname]" just above the crosshair.
local LINK_SLOT = "mp_round_result"
twitch_links = {}  -- npc id -> viewer nickname (global: write_state reports it)
local link_shown, next_link_check = nil, 0

local function set_static(slot, text)
	local hud = get_hud()
	if not hud then return end
	if not text or text == "" then
		hud:RemoveCustomStatic(slot)
		return
	end
	local st = hud:GetCustomStatic(slot)
	if not st then
		hud:AddCustomStatic(slot, true)
		st = hud:GetCustomStatic(slot)
	end
	if st and not pcall(function() st:wnd():TextControl():SetTextST(text) end) then
		st:wnd():SetTextST(text)
	end
end

local function set_status(text, ms)
	pcall(set_static, STATUS_SLOT, text)
	status_until = (text and text ~= "" and ms) and (time_global() + ms) or 0
end

local function show_subtitle(npc_id, text)
	local npc = npc_id and level.object_by_id(npc_id)
	local who = npc and npc:character_name() or db.actor:character_name()
	pcall(set_static, SUB_SLOT, who .. ": " .. text)
	sub_until = time_global() + math.min(12000, math.max(2500, string.len(text) * 65))
end

-- ------------------------------------------------------------- inbox (AI replies)
local function show_line(npc_id, text, caption, showtime)
	local npc = npc_id and level.object_by_id(npc_id)
	local icon = "ui_inGame2_Hero"
	caption = caption or ""
	if npc then
		caption = npc:character_name()
		local ok, ic = pcall(function() return npc:character_icon() end)
		if ok and ic then icon = ic end
	end
	db.actor:give_game_news(caption, text, icon, 0, showtime or 9000, 0)
end

-- ------------------------------------------------------------- Zone events (a Twitch channel-points reward)
-- The app rolls the event and sends "zone||<what>|<PDA caption>|<PDA text>"; the PDA line comes first, then:
--   gift                  a random item of the game lands in your backpack ("{item}" in the text = its name)
--   life:ally:<nick>      a Loner (free stalker, any rank and gear) appears 15-30 m away and follows you
--                         (and stays your friend while he lives)
--   life:enemy:<nick>     a random stalker of any faction attacks you; both wear the viewer's nickname until they die
--   child:<n>:<s1>,<s2>   n mutants (of whichever of these sections the game has) 25-50 m away, coming for you
-- Before each event the game is saved as "talker_autosave" (one save, overwritten), the way the game's own
-- scenario autosaves do it; the event then waits 1.5 s so the save is surely made before anything appears.
-- No save while you are dead or talking, during an emission or a tutorial/scripted scene, or if one was made
-- in the last 10 s (two events close together: one save).
-- Only sections the game really has are used; quest and dev items are never in the list. Checked against the
-- game's own configs (configs.db + patches): every item here exists, has a cost and no quest_item flag; unique
-- named weapons (Nimble's orders, Snag's...) are left out so no quest finds them in your pack too early.
local ZONE_ITEMS = {
	"wpn_pm", "wpn_pb", "wpn_fort", "wpn_hpsa", "wpn_walther", "wpn_usp", "wpn_colt1911", "wpn_desert_eagle",
	"wpn_sig220", "wpn_beretta", "wpn_bm16", "wpn_toz34", "wpn_wincheaster1300", "wpn_spas12", "wpn_protecta",
	"wpn_ak74u", "wpn_ak74", "wpn_abakan", "wpn_groza", "wpn_val", "wpn_vintorez", "wpn_l85", "wpn_lr300",
	"wpn_sig550", "wpn_g36", "wpn_fn2000", "wpn_mp5", "wpn_svd", "wpn_svu", "wpn_gauss", "wpn_rg-6", "wpn_rpg7",
	"wpn_pkm", "wpn_addon_scope", "wpn_addon_scope_susat", "wpn_addon_silencer", "wpn_addon_grenade_launcher",
	"wpn_addon_grenade_launcher_m203", "wpn_addon_scope_x2.7", "wpn_addon_scope_susat_x1.6",
	"wpn_addon_scope_susat_custom", "wpn_addon_scope_susat_dusk", "wpn_addon_scope_susat_night",
	"wpn_addon_scope_night", "wpn_binoc", "grenade_f1", "grenade_rgd5", "grenade_gd-05",
	"ammo_9x18_fmj", "ammo_9x18_pmm", "ammo_9x19_fmj", "ammo_9x19_pbp", "ammo_11.43x23_fmj", "ammo_11.43x23_hydro",
	"ammo_12x70_buck", "ammo_12x76_zhekan", "ammo_5.45x39_fmj", "ammo_5.45x39_ap",
	"ammo_5.56x45_ss190", "ammo_5.56x45_ap", "ammo_7.62x54_7h1",
	"ammo_9x39_pab9", "ammo_9x39_ap", "ammo_pkm_100", "ammo_vog-25", "ammo_m209", "ammo_og-7b", "ammo_gauss",
	"novice_outfit", "stalker_outfit", "scientific_outfit", "specops_outfit", "military_outfit", "dolg_outfit",
	"dolg_heavy_outfit", "svoboda_light_outfit", "svoboda_heavy_outfit", "exo_outfit", "cs_heavy_outfit",
	"helm_respirator", "helm_hardhat", "helm_protective", "helm_tactic", "helm_battle",
	"af_medusa", "af_vyvert", "af_gravi", "af_gold_fish", "af_blood", "af_mincer_meat", "af_soul",
	"af_electra_sparkler", "af_electra_flash", "af_electra_moonlight", "af_dummy_battery", "af_dummy_dummy",
	"af_fireball", "af_cristall", "af_cristall_flower", "af_night_star", "af_eye", "af_fire", "af_glass", "af_ice",
	"af_baloon", "af_compass", "af_fuzz_kolobok", "af_dummy_glassbeads",
	"bread", "kolbasa", "conserva", "vodka", "energy_drink", "medkit", "medkit_army", "medkit_scientic", "bandage",
	"antirad", "drug_booster", "drug_coagulant", "drug_psy_blockade", "drug_antidot", "drug_radioprotector",
	"drug_anabiotic", "detector_simple", "detector_advanced", "detector_elite", "detector_scientific",
}
-- Gift odds, all in these lines: the cheaper an item (its "cost" in the game's configs, the base of trade
-- prices), the more often it comes: weight = (100 / cost) ^ ZONE_PRICE_POWER. 0.6: bread (10) comes ~40x as
-- often as an exoskeleton (50000); higher = expensive things rarer still, 0 = every item alike.
-- Weapon add-ons (scopes, silencer, grenade launchers) are rarer than their price says: x0.15, so a 200-coupon
-- silencer comes far less often than vodka or a medkit. Same formula: tools/check_zone_sections.py --odds.
local ZONE_PRICE_POWER = 0.6
local ZONE_ITEM_RARER = { { "^wpn_addon_", 0.15 } }

local function zone_item_weight(sec)
	local ok, cost = pcall(function() return system_ini():r_float(sec, "cost") end)
	cost = (ok and cost and cost > 0) and cost or 1000
	local w = (100 / math.max(cost, 10)) ^ ZONE_PRICE_POWER
	for _, rule in ipairs(ZONE_ITEM_RARER) do
		if string.find(sec, rule[1]) then w = w * rule[2] end
	end
	return w
end

local ZONE_PEOPLE = { "stalker", "bandit", "duty", "freedom", "killer", "military", "monolith", "ecolog", "zombied" }
local zone_pending = {}  -- id of a man or mutant just created -> what to do once he is in the game
local zone_friends = {}  -- id of a Zone friend -> true: kept a Loner and your friend while he lives
local ZONE_SAVE = "talker_autosave"
local last_zone_save = nil  -- time_global() of the last autosave
local zone_delayed = {}     -- events waiting for their autosave to be written: { text, at, save }
local next_friend_check = 0
local zone_seeded = false

-- "4.1%": whole numbers from 10% up, one decimal from 1%; under 1% two significant digits, so a rare event
-- reads true and never "0.00%" ("0.25%", "0.00059%"). Same as zone.py's pct.
local function zone_pct(x)
	if x >= 9.95 then return string.format("%d%%", math.floor(x + 0.5)) end
	if x >= 0.995 then return string.format("%.1f%%", x) end
	if x <= 0 then return "0.00%" end
	local s = string.format("%." .. (1 - math.floor(math.log10(x))) .. "f", x)
	s = string.gsub(s, "0+$", "")
	return (string.gsub(s, "%.$", "")) .. "%"
end

local function section_ok(sec)
	local ok, yes = pcall(function() return system_ini():section_exist(sec) end)
	return ok and yes and true or false
end

-- An item the game has, by the weights above; also its share of all of them (0..1).
local function pick_gift()
	local have, total = {}, 0
	for _, sec in ipairs(ZONE_ITEMS) do
		if section_ok(sec) then
			local w = zone_item_weight(sec)
			table.insert(have, { sec, w })
			total = total + w
		end
	end
	if total <= 0 then return nil end
	local x = math.random() * total
	for _, h in ipairs(have) do
		x = x - h[2]
		if x <= 0 then return h[1], h[2] / total end
	end
	local last = have[#have]
	return last[1], last[2] / total
end

local function pick_existing(list)
	local have = {}
	for _, sec in ipairs(list) do
		if section_ok(sec) then table.insert(have, sec) end
	end
	return have[1] and have[math.random(#have)] or nil
end

-- A walkable spot min_d..max_d metres from you, in a random direction (a wall in the way: a closer one).
local function zone_point(min_d, max_d)
	local actor = db.actor
	local apos, from = actor:position(), actor:level_vertex_id()
	local best, best_lv, best_d = nil, nil, 3
	for _ = 1, 12 do
		local a = math.random() * 2 * math.pi
		local lv = level.vertex_in_direction(from, vector():set(math.cos(a), 0, math.sin(a)),
			min_d + math.random() * (max_d - min_d))
		if lv and lv ~= from and lv < 4294967295 then  -- -1: no vertex there (never ask its position)
			local pos = level.vertex_position(lv)
			local d = pos:distance_to(apos)
			if d >= min_d then return pos, lv end
			if d > best_d then best, best_lv, best_d = pos, lv, d end
		end
	end
	return best, best_lv
end

local function zone_spawn(sec, pos, lv, pending)
	local se = alife():create(sec, pos, lv, db.actor:game_vertex_id())
	pending.till = time_global() + 30000
	zone_pending[se.id] = pending
	return se.id
end

-- A tiny hit from you: a mutant that hasn't seen you yet knows now who to go for.
local function zone_provoke(obj)
	local h = hit()
	h.draftsman = db.actor
	h.type = hit.wound
	h.power = 0.001
	h.impulse = 0
	h.direction = vector():set(obj:position()):sub(db.actor:position())
	obj:hit(h)
end

-- «Шари Суслова» layout, in metres: the two balls this far ahead of the player and this far to each side,
-- the sausage's middle further ahead by SUSLOV_SHAFT, right between them.
SUSLOV_AHEAD, SUSLOV_SHAFT, SUSLOV_BALLS = 1.6, 0.28, { 0.12, -0.12 }

-- «Хуй будеш?» (Twitch reward): one pseudogiant (any of these the game has), this many metres from the player.
GIANT_SECTIONS, GIANT_NEAR, GIANT_FAR = { "gigant_normal", "gigant_strong", "gigant_big_strong" }, 15, 30

-- «Анекдот» layout, in metres: the bread and the sausage side by side this far ahead of the player (ANEKDOT_SIDE to
-- each side), ANEKDOT_BOLTS bolts scattered all round that spot, ANEKDOT_SPREAD[1] to [2] metres from it.
ANEKDOT_AHEAD, ANEKDOT_SIDE, ANEKDOT_BOLTS, ANEKDOT_SPREAD = 1.8, 0.15, 12, { 0.4, 1.0 }

-- «62» (Twitch reward): the streamer's clip (gamedata\sounds\talker\sixty_two*.ogg, mono for 3D) played SIXTY_TWO_COUNT
-- times at once, every copy from its own spot around the player (in its own slice of the circle, SIXTY_TWO_NEAR to
-- _FAR metres away, SIXTY_TWO_HEIGHT[1] to [2] metres up), at its own volume (SIXTY_TWO_VOLUME, 1 = full), pitch
-- (SIXTY_TWO_PITCH: 1 = as recorded; the engine plays a lower one deeper and slower too) and start delay
-- (SIXTY_TWO_DELAY, seconds), so they overlap and echo all round. Each copy is heard at full volume within
-- SIXTY_TWO_RANGE[1] metres, fading out by [2]. SIXTY_TWO_SOUNDS: the clip as recorded, slowed down (x0.65) and sped
-- up (x1.6) at the same pitch, with each one's length in seconds; the copies are shared out among them, mixed up.
SIXTY_TWO_SOUNDS = { { "talker\\sixty_two", 3.09 }, { "talker\\sixty_two_slow", 4.75 }, { "talker\\sixty_two_fast", 1.93 } }
SIXTY_TWO_COUNT = 10
SIXTY_TWO_NEAR, SIXTY_TWO_FAR, SIXTY_TWO_HEIGHT = 3, 15, { 0.5, 3 }
SIXTY_TWO_VOLUME, SIXTY_TWO_PITCH, SIXTY_TWO_DELAY = { 0.35, 1.0 }, { 0.7, 1.5 }, { 0, 2.5 }
SIXTY_TWO_RANGE = { 5, 60 }
ZONE_NO_SAVE = { ["62"] = true }  -- Zone events with no autosave first: only a sound, nothing worth saving for
sixty_two_sounds = {}  -- copies not done yet: a sound_object Lua lets go of is stopped by the garbage collector

local function shuffle(list)
	for i = #list, 2, -1 do local j = math.random(i); list[i], list[j] = list[j], list[i] end
	return list
end

-- n values from lo to hi, one in each of n equal slices (so no two are alike), in random order
local function spread(n, lo, hi)
	local list = {}
	for i = 1, n do list[i] = lo + (i - 1 + math.random()) * (hi - lo) / n end
	return shuffle(list)
end

-- «62»: starts every copy (each waits out its own delay in the engine). Returns how many, or nil and why not.
local function sixty_two()
	for _, v in ipairs(SIXTY_TWO_SOUNDS) do
		local okf, file = pcall(function() return getFS():exist("$game_sounds$", v[1] .. ".ogg") end)
		if okf and not file then return nil, "no sound " .. v[1] .. " (run install_mod.ps1)" end
	end
	local n = SIXTY_TWO_COUNT
	local kinds = {}  -- which version each copy plays: all of them about equally often, in random order
	for i = 1, n do kinds[i] = SIXTY_TWO_SOUNDS[(i - 1) % #SIXTY_TWO_SOUNDS + 1] end
	shuffle(kinds)
	local vols = spread(n, SIXTY_TWO_VOLUME[1], SIXTY_TWO_VOLUME[2])
	local pitches = spread(n, SIXTY_TWO_PITCH[1], SIXTY_TWO_PITCH[2])
	local delays = spread(n, SIXTY_TWO_DELAY[1], SIXTY_TWO_DELAY[2])
	local apos, now = db.actor:position(), time_global()
	for i = 1, n do
		local a = (i - 1 + math.random()) * 2 * math.pi / n
		local r = SIXTY_TWO_NEAR + math.random() * (SIXTY_TWO_FAR - SIXTY_TWO_NEAR)
		local h = SIXTY_TWO_HEIGHT[1] + math.random() * (SIXTY_TWO_HEIGHT[2] - SIXTY_TWO_HEIGHT[1])
		local snd = sound_object(kinds[i][1])
		snd:play_at_pos(db.actor, vector():set(apos.x + r * math.cos(a), apos.y + h, apos.z + r * math.sin(a)),
			delays[i], sound_object.s3d)
		-- set after play: starting a sound resets its volume, pitch and range
		snd.volume, snd.frequency = vols[i], pitches[i]
		snd.min_distance, snd.max_distance = SIXTY_TWO_RANGE[1], SIXTY_TWO_RANGE[2]
		table.insert(sixty_two_sounds, { snd = snd, till = now + (delays[i] + kinds[i][2] / pitches[i]) * 1000 + 2000 })
	end
	return n
end

local function update_sixty_two(now)  -- let go of the copies that have finished
	for i = #sixty_two_sounds, 1, -1 do
		if now > sixty_two_sounds[i].till then table.remove(sixty_two_sounds, i) end
	end
end

-- What «Шари Суслова» lays out stays a prop: once it has settled on the ground its physics is pinned (it doesn't
-- roll, slide or get kicked away), a fireball is always shown (the game hides an artifact on the ground after a few
-- seconds from anyone without a detector), and whoever picks one up (the player or an NPC) has it put straight back
-- where it lay. Kept with the save (the player's pstor), so it holds after a reload too.
-- A loose prop («Анекдот») is never pinned: it rolls and can be kicked about. Each second its spot follows it while
-- it lies on the ground, and whoever picks it up has it put back where it last lay.
local props = {}  -- id -> { x, y, z, af = is an artifact, pinned = settled and pinned, loose, seen = ms it came online }
local props_loaded, next_props_check = false, 0
local PROPS_KEY, PROPS_SETTLE = "talker_props", 1500

local function props_save()
	local parts = {}
	for id, p in pairs(props) do
		-- a loose prop adds ":1"; the rest are saved just as before it existed (old saves read the same)
		table.insert(parts, string.format("%d:%.3f:%.3f:%.3f:%d:%d", id, p.x, p.y, p.z, p.af and 1 or 0, p.pinned and 1 or 0)
			.. (p.loose and ":1" or ""))
	end
	pcall(function() return xr_logic.pstor_store(db.actor, PROPS_KEY, table.concat(parts, ";")) end)
end

local function props_load()
	props_loaded = true
	local ok, s = pcall(function() return xr_logic.pstor_retrieve(db.actor, PROPS_KEY, "") end)
	if not ok or type(s) ~= "string" then return end
	for item in string.gmatch(s, "[^;]+") do
		local id, x, y, z, af, pinned, loose =
			string.match(item, "^(%d+):([-%d.]+):([-%d.]+):([-%d.]+):(%d):(%d):?(%d?)$")
		if id then
			props[tonumber(id)] = { x = tonumber(x), y = tonumber(y), z = tonumber(z), af = af == "1", pinned = pinned == "1",
				loose = loose == "1" }
		end
	end
end

local function prop_add(se, p, af, loose)
	if se and se.id then props[se.id] = { x = p.x, y = p.y, z = p.z, af = af, pinned = false, loose = loose }; props_save() end
end

local function pin(obj)  -- every piece of its physics fixed where it is
	local shell = obj:get_physics_shell()
	if not shell then return end
	for i = 0, shell:get_elements_number() - 1 do
		local el = shell:get_element_by_order(i)
		if el and not el:is_fixed() then el:fix() end
	end
end

local function update_prop(id, p, now)
	local obj = level.object_by_id(id)
	if not obj then
		p.seen = nil
		if not alife():object(id) then props[id] = nil; return true end  -- gone for good (just offline: kept)
		return false
	end
	local holder = obj:parent()
	if holder then  -- picked up: back on the ground where it lay
		holder:drop_item_and_teleport(obj, vector():set(p.x, p.y, p.z))
		p.seen = now
		return false
	end
	if p.loose then  -- free to roll and be kicked: only its spot follows it, for when someone picks it up
		local pos = obj:position()
		local dx, dy, dz = pos.x - p.x, pos.y - p.y, pos.z - p.z
		if dx * dx + dy * dy + dz * dz < 0.01 then return false end  -- still there (within 10 cm): nothing to save
		p.x, p.y, p.z = pos.x, pos.y, pos.z
		return true
	end
	if p.af then obj:get_artefact():SwitchVisibility(true) end  -- every second: never hides (it would after 5 s)
	p.seen = p.seen or now
	if not p.pinned and now - p.seen < PROPS_SETTLE then return false end  -- let it settle on the ground first
	local changed = false
	if not p.pinned then
		local pos = obj:position()
		p.x, p.y, p.z, p.pinned, changed = pos.x, pos.y, pos.z, true, true
	end
	pin(obj)  -- again each time: a drop or coming back online makes new, loose physics
	return changed
end

local function update_props()
	local now, changed = time_global(), false
	for id, p in pairs(props) do
		local ok, res = pcall(update_prop, id, p, now)
		if not ok then log_error("prop " .. tostring(id) .. ": " .. tostring(res))
		elseif res then changed = true end
	end
	if changed then props_save() end
end

-- Spots on the ground in front of the player, for laying things out: at(ahead, side) is so many metres ahead of where
-- he looks and so many to his side, on the ground there (just above it, so nothing sinks in), and its level vertex.
local function ground_ahead(actor)
	local d = actor:direction()
	local fx, fz = d.x, d.z
	local len = math.sqrt(fx * fx + fz * fz)
	if len < 0.01 then fx, fz, len = 0, 1, 1 end
	fx, fz = fx / len, fz / len   -- where he looks, flat on the ground
	local rx, rz = fz, -fx        -- to his side
	local apos = actor:position()
	return function(ahead, side)
		local p = vector():set(apos.x + fx * ahead + rx * side, apos.y, apos.z + fz * ahead + rz * side)
		local lv = level.vertex_id(p)
		if lv and lv < 4294967295 then p.y = level.vertex_position(lv).y else lv = actor:level_vertex_id() end
		p.y = p.y + 0.1
		return p, lv
	end
end

-- «Вова Віст» (Twitch reward): a soldier (військовий) whose machine gun, wpn_vova_vist (configs\talker_items.ltx, added
-- by install_mod.ps1), fires 100x as fast as a PKM and does 1000x less damage. He stays neutral to the player and is at
-- war with every other man and mutant within VOVA_RANGE metres. His belt is kept full, so he never stops to reload.
-- Kept with the save (the player's pstor), so it holds after a reload too.
VOVA_GUN, VOVA_BELT, VOVA_RANGE = "wpn_vova_vist", 5000, 60
local VOVA_KEEP = { wpn_knife = true, wpn_binoc = true }  -- the rest of his own guns and grenades go
local vovas = {}  -- id -> true while he lives
local vovas_loaded, next_vova_check = false, 0
local VOVA_KEY = "talker_vova"

local function vova_save()
	local ids = {}
	for id in pairs(vovas) do table.insert(ids, tostring(id)) end
	pcall(function() return xr_logic.pstor_store(db.actor, VOVA_KEY, table.concat(ids, ",")) end)
end

local function vova_load()
	vovas_loaded = true
	local ok, s = pcall(function() return xr_logic.pstor_retrieve(db.actor, VOVA_KEY, "") end)
	if not ok or type(s) ~= "string" then return end
	for id in string.gmatch(s, "%d+") do vovas[tonumber(id)] = true end
end

-- Once he's in the game: only the machine gun is left to him (so it's the one he fights with), and he's neutral to you.
local function vova_arm(obj)
	local junk = {}
	obj:iterate_inventory(function(_, item)
		local sec = item:section()
		if sec ~= VOVA_GUN and not VOVA_KEEP[sec] and (string.find(sec, "^wpn_") or string.find(sec, "^grenade_")) then
			table.insert(junk, item:id())
		end
	end, obj)
	for _, id in ipairs(junk) do
		local se = alife():object(id)
		if se then alife():release(se, true) end
	end
	make_neutral(obj)
end

local function update_vova(id, obj)
	local gun = obj:object(VOVA_GUN)
	if gun then gun:set_ammo_elapsed(VOVA_BELT) end  -- every second: at 875 shots a second the belt never runs dry
	if obj:relation(db.actor) == game_object.enemy then make_neutral(obj) end  -- you shot him: still not your enemy
	local pos = obj:position()
	for oid in pairs(db.storage) do
		local o = oid ~= id and not vovas[oid] and level.object_by_id(oid)
		if o and o:alive() and (is_stalker(o) or IsMonster(o)) and o:position():distance_to(pos) < VOVA_RANGE
				and not (grudges[id] and grudges[id][oid]) then
			add_grudge(obj, o)  -- he opens up on everyone around (and whoever he hits fights back: on_feud_hit)
		end
	end
	for other in pairs(vovas) do  -- two of them: they whistle at each other too
		local o = other ~= id and level.object_by_id(other)
		if o and o:alive() and o:position():distance_to(pos) < VOVA_RANGE and not (grudges[id] and grudges[id][other]) then
			add_grudge(obj, o)
		end
	end
end

local function update_vovas()
	local changed = false
	for id in pairs(vovas) do
		local obj = level.object_by_id(id)
		if not obj then
			if not alife():object(id) then vovas[id] = nil; changed = true end  -- gone for good (just offline: kept)
		elseif not obj:alive() then
			vovas[id] = nil; changed = true
		elseif not zone_pending[id] then  -- armed (zone_pending: still coming into the game)
			local ok, err = pcall(update_vova, id, obj)
			if not ok then log_error("vova " .. tostring(id) .. ": " .. tostring(err)) end
		end
	end
	if changed then vova_save() end
end

-- A named man of a faction with a stock gun (Twitch rewards such as «Гоша»):
--   "npc:<tag>:<community>:<weapon>:<side>:<nick>|<his name>|<PDA text>"
-- sim_default_<community>_<rank> 15-30 m away, named after the PDA caption (the game's own name for him, kept with
-- the save), with <weapon> (a section the game has; empty = his own) and two packs of its first ammo. Once he's in
-- the game every other gun and grenade of his goes, so that weapon is the one he fights with. side: enemy (comes
-- for you), neutral, ally (follows you, stays of his own faction). <nick>: the viewer, on the label over his head.
local NPC_KEEP = { wpn_knife = true, wpn_binoc = true }  -- never taken from him
local zone_arming = {}  -- id -> { gun, till }: his own guns are taken for a few seconds (his gear comes late)

-- Every gun and grenade he carries but this one (and the knife and binoculars) is gone.
local function zone_strip(obj, gun)
	local junk = {}
	obj:iterate_inventory(function(_, item)
		local sec = item:section()
		if sec ~= gun and not NPC_KEEP[sec] and (string.find(sec, "^wpn_") or string.find(sec, "^grenade_")) then
			table.insert(junk, item:id())
		end
	end, obj)
	for _, id in ipairs(junk) do
		local se = alife():object(id)
		if se then alife():release(se, true) end
	end
	return #junk
end

-- The first ammo a weapon takes ("ammo_class = ammo_12x70_buck, ammo_12x76_zhekan, ..."), or nil.
local function weapon_ammo(gun)
	local ok, list = pcall(function() return system_ini():r_string(gun, "ammo_class") end)
	local ammo = ok and list and string.match(list, "^%s*([^,%s]+)")
	return ammo and section_ok(ammo) and ammo or nil
end

-- A man of that community (any rank the game has) min_d..max_d metres away, named, with that gun.
-- Returns the server object and his section, or nil and why not.
local function zone_named(community, name, gun, min_d, max_d, pending)
	local people = {}
	for rank = 0, 4 do table.insert(people, "sim_default_" .. community .. "_" .. rank) end
	local sec = pick_existing(people)
	if not sec then return nil, "no " .. community end
	if gun ~= "" and not section_ok(gun) then return nil, "no " .. gun end
	local pos, lv = zone_point(min_d, max_d)
	if not pos then return nil, "no place" end
	local gv = db.actor:game_vertex_id()
	local se = alife():create(sec, pos, lv, gv)
	if name and name ~= "" then
		-- before he comes online (the next A-Life update), so the name goes with him into the game and the save.
		-- rank() first: it picks his profile now, which would overwrite a name set before it.
		local okn, err = pcall(function() se:rank(); se:set_character_name(name) end)
		if not okn then log_error("npc name: " .. tostring(err)) end
	end
	if gun ~= "" then
		alife():create(gun, pos, lv, gv, se.id)
		local ammo = weapon_ammo(gun)
		if ammo then for _ = 1, 2 do alife():create(ammo, pos, lv, gv, se.id) end end
	end
	pending.till = time_global() + 30000
	zone_pending[se.id] = pending
	return se, sec
end

local function zone_event(text, save)
	if not zone_seeded then zone_seeded = true; math.randomseed(os.time()) end
	local what, caption, msg = string.match(text, "^([^|]*)|([^|]*)|(.*)$")
	what = what or text
	local function say(item, share)
		if not msg or msg == "" then return end
		local line = string.gsub(msg, "{item}", (string.gsub(item or "", "%%", "%%%%")))
		-- "{chance:25}": a gift's chance (25%) times this item's share of all gifts: its own chance
		line = string.gsub(line, "{chance:([%d.]+)}", function(base) return zone_pct(tonumber(base) * (share or 1)) end)
		show_line(nil, line, caption, 12000)
		pcall(xr_sound.set_sound_play, db.actor:id(), "pda_tips")
	end
	local done = { type = "zone_done", what = what, ok = false, autosave = save }
	if what == "gift" then
		local sec, share = pick_gift()
		if not sec then done.reason = "no item"; return append_event(done) end
		say(item_title(sec) or sec, share)
		local actor = db.actor
		alife():create(sec, actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
		pcall(news_manager.relocate_item, actor, "in", sec)
		done.ok, done.section, done.name = true, sec, item_title(sec)
		return append_event(done)
	end
	local side, nick = string.match(what, "^life:(%a+):(.*)$")
	if side == "ally" or side == "enemy" then
		local people = {}
		for _, f in ipairs(side == "ally" and { "stalker" } or ZONE_PEOPLE) do  -- a friend is always a Loner
			for rank = 0, 4 do table.insert(people, "sim_default_" .. f .. "_" .. rank) end
		end
		local sec = pick_existing(people)
		local pos, lv = zone_point(15, 30)
		if not sec or not pos then done.reason = sec and "no place" or "no stalker"; return append_event(done) end
		say()
		done.id = zone_spawn(sec, pos, lv, { what = "life", side = side, nick = nick })
		done.ok, done.section, done.side, done.nick = true, sec, side, nick
		return append_event(done)
	end
	local n, list = string.match(what, "^child:(%d+):(.+)$")
	if n then
		local secs = {}
		for sec in string.gmatch(list, "[^,]+") do table.insert(secs, sec) end
		local sec = pick_existing(secs)
		if not sec then done.reason = "no mutant"; return append_event(done) end
		local spots = {}
		for _ = 1, math.max(1, math.min(10, tonumber(n))) do
			local pos, lv = zone_point(25, 50)
			if pos then table.insert(spots, { pos, lv }) end
		end
		if not spots[1] then done.reason = "no place"; return append_event(done) end
		say()
		for _, s in ipairs(spots) do zone_spawn(sec, s[1], s[2], { what = "child" }) end
		done.ok, done.section, done.count = true, sec, #spots
		return append_event(done)
	end
	if what == "suslov" then  -- «Шари Суслова»: two «Вогняна куля» side by side, a «Ковбаса» between them pointing away
		local actor = db.actor
		if not pick_existing({ "af_fireball" }) or not pick_existing({ "kolbasa" }) then
			done.reason = "no item"; return append_event(done)
		end
		local at, gv = ground_ahead(actor), actor:game_vertex_id()
		for _, side in ipairs(SUSLOV_BALLS) do
			local p, lv = at(SUSLOV_AHEAD, side)
			prop_add(alife():create("af_fireball", p, lv, gv), p, true)
		end
		local p, lv = at(SUSLOV_AHEAD + SUSLOV_SHAFT, 0)
		prop_add(alife():create("kolbasa", p, lv, gv), p, false)
		say()
		done.ok, done.section = true, "af_fireball x2, kolbasa"
		return append_event(done)
	end
	if what == "anekdot" then  -- «Анекдот»: a «Хліб» and a «Ковбаса» side by side, bolts scattered all round them
		local actor = db.actor
		if not pick_existing({ "bread" }) or not pick_existing({ "kolbasa" }) or not pick_existing({ "bolt" }) then
			done.reason = "no item"; return append_event(done)
		end
		local at, gv = ground_ahead(actor), actor:game_vertex_id()
		local function drop(sec, ahead, side)  -- a loose prop: it rolls and gets kicked, but nobody keeps it
			local p, lv = at(ahead, side)
			prop_add(alife():create(sec, p, lv, gv), p, false, true)
		end
		drop("bread", ANEKDOT_AHEAD, -ANEKDOT_SIDE)
		drop("kolbasa", ANEKDOT_AHEAD, ANEKDOT_SIDE)
		local lo, hi = ANEKDOT_SPREAD[1], ANEKDOT_SPREAD[2]
		for i = 1, ANEKDOT_BOLTS do  -- each bolt in its own slice of the circle, at a random angle and distance in it
			local a = (i - 0.8 + math.random() * 0.6) * 2 * math.pi / ANEKDOT_BOLTS
			local r = lo + math.random() * (hi - lo)
			drop("bolt", ANEKDOT_AHEAD + r * math.cos(a), r * math.sin(a))
		end
		say()
		done.ok, done.section = true, "bread, kolbasa, bolt x" .. ANEKDOT_BOLTS
		return append_event(done)
	end
	if what == "vova" then  -- «Вова Віст»: a soldier named after the caption, with the whistling machine gun
		if not section_ok(VOVA_GUN) then done.reason = "no " .. VOVA_GUN .. " (run install_mod.ps1)"; return append_event(done) end
		local soldiers = {}
		for rank = 0, 4 do table.insert(soldiers, "sim_default_military_" .. rank) end
		local sec = pick_existing(soldiers)
		local pos, lv = zone_point(8, 15)
		if not sec or not pos then done.reason = sec and "no place" or "no soldier"; return append_event(done) end
		local gv = db.actor:game_vertex_id()
		local se = alife():create(sec, pos, lv, gv)
		-- before he comes online (the next A-Life update), so the name goes with him into the game and the save
		if caption and caption ~= "" then
			local okn, err = pcall(function() se:set_character_name(caption) end)
			if not okn then log_error("vova name: " .. tostring(err)) end
		end
		alife():create(VOVA_GUN, pos, lv, gv, se.id)  -- in his hands, belt full
		zone_pending[se.id] = { what = "vova", till = time_global() + 30000 }
		vovas[se.id] = true
		vova_save()
		say()
		done.ok, done.section, done.id, done.name = true, sec, se.id, caption
		return append_event(done)
	end
	local tag, community, gun, nside, nnick = string.match(what, "^npc:([%w_]+):([%w_]+):([%w_%.%-]*):(%a+):(.*)$")
	if tag then  -- a named man of a faction with a stock gun («Гоша»), at once
		local se, res = zone_named(community, caption, gun, 15, 30,
			{ what = "npc", tag = tag, side = nside, nick = nnick, gun = gun, name = caption })
		if not se then done.reason = res; return append_event(done) end
		say()
		done.ok, done.section, done.id, done.name, done.tag, done.weapon = true, res, se.id, caption, tag, gun
		return append_event(done)
	end
	if what == "giant" then  -- «Хуй будеш?»: one pseudogiant close by, your enemy and provoked, like a Zone mutant
		local sec = pick_existing(GIANT_SECTIONS)
		local pos, lv = zone_point(GIANT_NEAR, GIANT_FAR)
		if not sec or not pos then done.reason = sec and "no place" or "no mutant"; return append_event(done) end
		say()
		done.id = zone_spawn(sec, pos, lv, { what = "child" })
		done.ok, done.section, done.count = true, sec, 1
		return append_event(done)
	end
	if what == "62" then  -- «62»: the streamer's clip shouted 10 times from all round, overlapping (sixty_two)
		local count, why = sixty_two()
		if not count then done.reason = why; return append_event(done) end
		say()
		done.ok, done.section, done.count = true, "sixty_two", count
		return append_event(done)
	end
	done.reason = "unknown"
	append_event(done)
end

-- A Zone friend: a Loner (community "stalker"), friendly to you, also in A-Life (so the simulation keeps it).
local function zone_befriend(obj)
	if obj:character_community() ~= "stalker" then
		pcall(function() obj:set_character_community("stalker", 0, 0) end)
	end
	if grudges[obj:id()] then grudges[obj:id()][db.actor:id()] = nil end
	pcall(function() obj:set_relation(game_object.friend, db.actor) end)
	pcall(function() obj:force_set_goodwill(1000, db.actor) end)
	pcall(function() alife():object(obj:id()):force_set_goodwill(1000, db.actor:id()) end)
end

-- Men and mutants from zone_event come into the game a moment later: then they get their side and nickname.
local function update_zone()
	local now = time_global()
	if next(zone_friends) and now >= next_friend_check then
		next_friend_check = now + 2000  -- a stray shot or the game's own logic turned him: he's your friend again
		for id in pairs(zone_friends) do
			local obj = level.object_by_id(id)
			if not obj or not obj:alive() then
				zone_friends[id] = nil
			elseif obj:relation(db.actor) ~= game_object.friend or obj:character_community() ~= "stalker" then
				zone_befriend(obj)
			end
		end
	end
	for id, a in pairs(zone_arming) do  -- his own gear can come a moment after him: take it again for a few seconds
		local obj = level.object_by_id(id)
		if not obj or not obj:alive() or now > a.till then
			zone_arming[id] = nil
		else
			local ok, err = pcall(zone_strip, obj, a.gun)
			if not ok then zone_arming[id] = nil; log_error("npc strip: " .. tostring(err)) end
		end
	end
	for id, p in pairs(zone_pending) do
		local obj = level.object_by_id(id)
		local st = db.storage[id]
		if obj and st and st.object then
			if not p.seen then
				p.seen = now  -- his own logic starts first; ours goes on top of it a second later
			elseif now - p.seen > 1000 then
				zone_pending[id] = nil
				if p.what == "life" then
					if p.side == "ally" then
						zone_befriend(obj)
						zone_friends[id] = true
						local okf, err = pcall(start_follow, obj)
						if not okf then log_error("zone follow: " .. tostring(err)) end
					else
						add_grudge(obj, db.actor)
					end
					if p.nick ~= "" then twitch_links[id] = p.nick; link_shown = false end
					append_event({ type = "zone_spawned", id = id, nick = p.nick, side = p.side, npc = npc_info(obj) })
				elseif p.what == "npc" then  -- a named man (zone_named): his gun, his side, the viewer's label
					if p.gun ~= "" then
						local oks, err = pcall(zone_strip, obj, p.gun)
						if not oks then log_error("npc strip: " .. tostring(err)) end
						zone_arming[id] = { gun = p.gun, till = now + 5000 }
					end
					if p.side == "ally" then
						if grudges[id] then grudges[id][db.actor:id()] = nil end
						pcall(function() obj:set_relation(game_object.friend, db.actor) end)
						pcall(function() obj:force_set_goodwill(1000, db.actor) end)
						local okf, err = pcall(start_follow, obj)
						if not okf then log_error("npc follow: " .. tostring(err)) end
					elseif p.side == "neutral" then
						make_neutral(obj)
					else
						pcall(function() obj:set_relation(game_object.enemy, db.actor) end)
						add_grudge(obj, db.actor)  -- he really comes for you, even near a base
					end
					if p.nick ~= "" then twitch_links[id] = p.nick; link_shown = false end
					local info = npc_info(obj)
					append_event({ type = "zone_spawned", id = id, nick = p.nick, side = p.side, tag = p.tag,
						named = info.name == p.name, npc = info })
				elseif p.what == "vova" then
					local okv, err = pcall(vova_arm, obj)
					if not okv then log_error("vova arm: " .. tostring(err)) end
				else
					pcall(function() obj:set_relation(game_object.enemy, db.actor) end)
					local okp, err = pcall(zone_provoke, obj)
					if not okp then log_error("zone provoke: " .. tostring(err)) end
				end
			end
		elseif now > p.till then
			zone_pending[id] = nil
			log_error("zone: " .. tostring(id) .. " never came into the game")
		end
	end
end

-- Can the game be saved right now? (the reason it can't, otherwise)
local function zone_save_blocked()
	if not db.actor:alive() or db.actor.health <= 0 then return "dead" end
	if emission_active() then return "emission" end
	if db.actor:is_talking() then return "talking" end
	local okt, tutorial = pcall(function() return level.has_active_tutorial() end)
	if okt and tutorial then return "scene" end
	local okw, wfx = pcall(function() return level.is_wfx_playing() end)
	if okw and wfx then return "scene" end
	return nil
end

-- Saves before a Zone event. Returns "saved", or why it didn't ("recent", "dead", "emission", ...).
local function zone_autosave()
	local now = time_global()
	if last_zone_save and now - last_zone_save < 10000 then return "recent" end
	local why = zone_save_blocked()
	if why then return why end
	get_console():execute("save " .. ZONE_SAVE)
	last_zone_save = now
	return "saved"
end

-- A Zone line from the app: save first; the event itself goes off a moment later (in order, never before
-- an event that is still waiting for its save).
local function zone_line(text)
	local save = ZONE_NO_SAVE[string.match(text, "^[^|]*")] and "not needed" or zone_autosave()
	if save == "saved" or next(zone_delayed) then
		local last = zone_delayed[#zone_delayed]
		local at = time_global() + (save == "saved" and 1500 or 0)
		table.insert(zone_delayed, { text = text, at = last and math.max(last.at, at) or at, save = save })
	else
		zone_event(text, save)
	end
end

local function update_zone_delayed()
	while zone_delayed[1] and time_global() >= zone_delayed[1].at do  -- all whose time has come, in order
		local first = zone_delayed[1]
		table.remove(zone_delayed, 1)
		local ok, err = pcall(zone_event, first.text, first.save)
		if not ok then
			log_error("zone " .. first.text .. ": " .. tostring(err))
			append_event({ type = "zone_done", what = string.match(first.text, "^[^|]*"), ok = false, reason = tostring(err) })
		end
	end
end

local inbox_line  -- one inbox line; defined right after read_inbox

local function read_inbox()
	-- Rename first, then read: a line the app appends while we read would otherwise be deleted unread.
	-- If the app is writing right now the rename fails, and we simply try again in 200 ms.
	local name, taken = path("inbox.txt"), path("inbox.read")
	if not os.rename(name, taken) then return end
	local f = io.open(taken, "r")
	if not f then return end
	local body = f:read("*a")
	f:close()
	os.remove(taken)
	for line in string.gmatch(body, "[^\n]+") do
		-- each line on its own: one that fails (a dead NPC, a missing HUD) must not lose the ones after it
		local ok, err = pcall(inbox_line, (string.gsub(line, "\r$", "")))
		if not ok then log_error("inbox line: " .. tostring(err)) end
	end
end

inbox_line = function(line)  -- declared above read_inbox
	local kind, id, text = string.match(line, "^(%w+)|(%-?%d*)|(.*)$")
	if kind == "say" then show_line(tonumber(id), text)
	elseif kind == "you" then show_line(nil, text, db.actor:character_name())
	elseif kind == "info" then show_line(nil, text, "StalkerTalker", 3000)
	elseif kind == "sub" then show_subtitle(tonumber(id), text)
	elseif kind == "status" then set_status(text, 15000)
	elseif kind == "link" then  -- "link|<npc id>|<nickname>"; an empty nickname removes the link
		local npc_id = tonumber(id)
		if npc_id then twitch_links[npc_id] = (text ~= "" and text) or nil end
		link_shown = false  -- redraw the label
	elseif kind == "twitch" then
		local nick, msg = string.match(text, "^(.-): (.*)$")  -- viewer's nickname as the PDA caption
		show_line(nil, msg or text, (nick or "Twitch") .. " (Twitch)", 9000)
	elseif kind == "act" then
		local ok, err = pcall(do_action, tonumber(id), text)
		if not ok then log_error("act " .. text .. ": " .. tostring(err)) end
	elseif kind == "zone" then
		local ok, err = pcall(zone_line, text)
		if not ok then
			log_error("zone " .. text .. ": " .. tostring(err))
			append_event({ type = "zone_done", what = string.match(text, "^[^|]*"), ok = false, reason = tostring(err) })
		end
	end
end

-- ------------------------------------------------------------- keys (OpenXRay key callbacks)
-- Push-to-talk is caught here, so it only works while you're actually in the game. The companion app
-- reads talker\keys.txt; the "Слухаю..." line sits at the bottom of the screen while the key is held.
local keys = nil
local keys_owner = nil
local talking = false
local talk_since = 0

local function key_code(name)
	local ok, code = pcall(function() return DIK_keys[name] end)
	return ok and code or nil
end

local function load_keys()
	keys = { talk = key_code("DIK_T"), follow = key_code("DIK_Y"), stay = key_code("DIK_U") }
	local ok, ini = pcall(ini_file, "scripts\\talker.ltx")
	if ok and ini and ini:section_exist("keys") then
		for _, what in ipairs({ "talk", "follow", "stay" }) do
			if ini:line_exist("keys", what) then
				local name = ini:r_string("keys", what)
				keys[what] = (name ~= "" and name ~= "none") and key_code(name) or nil
			end
		end
	end
end

local function write_key(what)
	local f = io.open(path("keys.txt"), "a")
	if f then f:write(what .. "\n"); f:close() end
end


-- Who a hotkey order goes to: the stalker under the crosshair, else the nearest non-enemy within 7 m.
local function order_target()
	local target = level.get_target_obj and level.get_target_obj()
	local apos = db.actor:position()
	if target and is_stalker(target) and target:alive() and target:position():distance_to(apos) < 15 then
		return target
	end
	local best, best_d = nil, 7
	for id, _ in pairs(db.storage) do
		local obj = level.object_by_id(id)
		if is_stalker(obj) and obj:alive() and relation_name(obj) ~= "enemy" then
			local d = obj:position():distance_to(apos)
			if d < best_d then best, best_d = obj, d end
		end
	end
	return best
end

local function hotkey_order(order)
	local npc = order_target()
	if not npc then return end
	local ok, story = pcall(function() return get_object_story_id(npc:id()) end)
	local refused = (ok and story ~= nil) or relation_name(npc) == "enemy"
	local was_following = followers[npc:id()] and true or false
	if not refused then do_action(npc:id(), order) end
	append_event({ type = "order", order = order, npc = npc_info(npc), refused = refused,
		changed = (not refused) and (was_following ~= (order == "follow")) })
end

local function ui_open()
	local ok, ui = pcall(function() return level.main_input_receiver() end)
	return ok and ui ~= nil
end

local function on_key_press(key)
	if not keys or not db.actor then return end
	if key == keys.talk then
		-- allowed in the dialog window with an NPC, ignored while typing in other menus
		if ui_open() and not db.actor:is_talking() then return end
		talking, talk_since = true, time_global()  -- a repeat press is fine: the app ignores it
		write_key("ptt_down")
		set_status(LISTEN_TEXT)
	elseif ui_open() then
		return
	elseif key == keys.follow then
		hotkey_order("follow")
	elseif key == keys.stay then
		hotkey_order("stay")
	end
end

local function on_key_release(key)
	if keys and key == keys.talk and talking then
		talking = false
		write_key("ptt_up")
		set_status(THINK_TEXT, 15000)  -- the app clears it when the answer starts
	end
end

local event_cooldown = {}
local function event_once(kind, ms, ev)
	local now = time_global()
	if (event_cooldown[kind] or 0) > now then return end
	event_cooldown[kind] = now + ms
	ev.type = kind
	append_event(ev)
end

-- The player's death: who killed him (the last man who hit him), and which enemies stand around to gloat.
local last_hitter = nil   -- { id = npc id, at = ms }
local death_reported = false

local function report_actor_death()
	if death_reported or not db.actor then return end
	if db.actor.health > 0 and db.actor:alive() then return end
	death_reported = true
	local killer = nil
	if last_hitter and time_global() - last_hitter.at < 15000 then
		local obj = level.object_by_id(last_hitter.id)
		if obj and obj:alive() and is_stalker(obj) then killer = npc_info(obj) end
	end
	local enemies = { __array = true }
	local apos = db.actor:position()
	for id in pairs(db.storage) do
		local obj = level.object_by_id(id)
		if is_stalker(obj) and obj:alive() and (not killer or id ~= killer.id)
				and obj:relation(db.actor) == game_object.enemy and obj:position():distance_to(apos) < 40 then
			table.insert(enemies, npc_info(obj))
			if #enemies >= 3 then break end
		end
	end
	append_event({ type = "actor_death", killer = killer, enemies = enemies })
end

local function on_actor_hit(obj, amount, dir, who)
	if not who or not amount or amount < 0.02 or who:id() == db.actor:id() then return end
	if IsStalker(who) then
		last_hitter = { id = who:id(), at = time_global() }
		local ok, err = pcall(report_actor_death)  -- this shot may have been the last one
		if not ok then log_error("death: " .. tostring(err)) end
		return
	end
	if IsMonster(who) then return end
	event_once("anomaly_hit", 15000, { kind = who:section() })  -- burnt, shocked... by an anomaly
end

-- The actor object is new after every load, so the callbacks are (re)attached from update().
local function register_keys()
	if keys_owner == db.actor then return end
	keys_owner = db.actor
	talking = false
	death_reported, last_hitter = false, nil  -- a new life after a load
	os.remove(path("events.jsonl"))  -- old events mean nothing after a load (the app restarts from 0)
	load_keys()
	db.actor:set_callback(callback.key_press, function(key) safe(on_key_press, key) end)
	db.actor:set_callback(callback.hit, function(...) safe(on_actor_hit, ...) end)
	if callback.weapon_jammed then
		db.actor:set_callback(callback.weapon_jammed, function() safe(event_once, "jam", 10000, {}) end)
	end
	if callback.weapon_magazine_empty then
		db.actor:set_callback(callback.weapon_magazine_empty, function() safe(event_once, "mag_empty", 15000, {}) end)
	end
	if callback.key_release then
		db.actor:set_callback(callback.key_release, function(key) safe(on_key_release, key) end)
		write_key("game_keys")  -- tells the companion app that push-to-talk now comes from the game
	else
		keys.talk = nil  -- older engine without key release: the app keeps its own keyboard hook
	end
end

-- ------------------------------------------------------------- testing helper
-- talker\dev_money.txt holding a number tops your money up to it (the game's limit is 2147483647), once.
local next_dev_check = 0
local function dev_money()
	local f = io.open(path("dev_money.txt"), "r")
	if not f then return end
	local want = tonumber(f:read("*a"))
	f:close()
	os.remove(path("dev_money.txt"))
	if not want then return end
	want = math.min(math.floor(want), 2000000000)
	local add = want - db.actor:money()
	if add > 0 then
		db.actor:give_money(add)
		pcall(news_manager.relocate_money, db.actor, "in", add)
	end
	append_event({ type = "act_done", action = "dev_money:" .. want, ok = true, money = db.actor:money() })
end

-- ------------------------------------------------------------- hooks
local function update_link_label()
	local target = level.get_target_obj and level.get_target_obj()
	local nick = target and twitch_links[target:id()]
	if nick and not target:alive() then twitch_links[target:id()] = nil; nick = nil end
	local text = nick and (target:character_name() .. " [" .. nick .. "]") or nil
	if text ~= link_shown then
		link_shown = text
		set_static(LINK_SLOT, text)
	end
end

function update(delta)
	if not db.actor then return end
	if keys_owner ~= db.actor then
		local ok, err = pcall(register_keys)
		if not ok then log_error("keys: " .. tostring(err)) end
	end
	local now = time_global()
	if talking and now - talk_since > 30000 then on_key_release(keys.talk) end  -- release never came
	if status_until > 0 and now > status_until then set_status(nil) end
	if not death_reported and (db.actor.health <= 0 or not db.actor:alive()) then
		local ok, err = pcall(report_actor_death)
		if not ok then log_error("death: " .. tostring(err)) end
	end
	if sub_until > 0 and now > sub_until then sub_until = 0; pcall(set_static, SUB_SLOT, nil) end
	if now >= next_link_check and (next(twitch_links) or link_shown ~= nil) then
		next_link_check = now + 150
		local ok, err = pcall(update_link_label)
		if not ok then log_error("link label: " .. tostring(err)); link_shown = nil end
	end
	if next(contracts) or next(grudges) then pcall(update_contracts) end
	if next(zone_delayed) then
		local okd, errd = pcall(update_zone_delayed)
		if not okd then log_error("zone delayed: " .. tostring(errd)) end
	end
	if next(zone_pending) or next(zone_friends) or next(zone_arming) then
		local okz, errz = pcall(update_zone)
		if not okz then log_error("zone: " .. tostring(errz)) end
	end
	if not props_loaded then props_load() end
	if not vovas_loaded then vova_load() end
	if next(vovas) and now >= next_vova_check then
		next_vova_check = now + 1000
		local okv, errv = pcall(update_vovas)
		if not okv then log_error("vova: " .. tostring(errv)) end
	end
	if next(sixty_two_sounds) then update_sixty_two(now) end
	if next(props) and now >= next_props_check then
		next_props_check = now + 1000
		local okp, errp = pcall(update_props)
		if not okp then log_error("props: " .. tostring(errp)) end
	end
	if next(looks) then
		local okl, errl = pcall(update_looks)
		if not okl then log_error("looks: " .. tostring(errl)) end
	end
	if next(emotes) then
		local ok, err = pcall(update_emotes)
		if not ok then log_error("emotes: " .. tostring(err)) end
	end
	if now >= next_dev_check then
		next_dev_check = now + 2000
		local ok, err = pcall(dev_money)
		if not ok then log_error("dev_money: " .. tostring(err)) end
	end
	if now >= next_state_write then
		next_state_write = now + 500
		local ok, err = pcall(write_state)
		if not ok then log_error("state: " .. tostring(err)) end
	end
	if now >= next_inbox_check then
		next_inbox_check = now + 200
		local ok, err = pcall(read_inbox)
		if not ok then log_error("inbox: " .. tostring(err)) end
	end
end

function on_npc_death(victim, who)
	if victim then twitch_links[victim:id()] = nil end  -- a dead man speaks for nobody
	if not db.actor or not victim then return end
	local near = victim:position():distance_to(db.actor:position()) < 60
	local by_actor = who and who:id() == db.actor:id()
	if not (near or by_actor) then return end
	local killer = nil
	if by_actor then killer = { id = db.actor:id(), name = "actor" }
	elseif who and is_stalker(who) then killer = npc_info(who)
	elseif who then killer = { id = who:id(), name = who:name() } end
	local v = npc_info(victim)
	v.alive = false
	append_event({ type = "death", victim = v, killer = killer, by_actor = by_actor })
end

function on_npc_hit(npc, amount, who)
	if not db.actor or not npc or not who or amount <= 0 then return end
	if who:id() ~= db.actor:id() then
		pcall(on_feud_hit, npc, who)
		return
	end
	local now = time_global()
	if (hit_cooldown[npc:id()] or 0) > now then return end
	hit_cooldown[npc:id()] = now + 5000
	append_event({ type = "actor_hit_npc", npc = npc_info(npc), amount = amount })
end

function on_npc_use(npc, who)
	if not db.actor or not npc or not who or who:id() ~= db.actor:id() then return end
	append_event({ type = "actor_use_npc", npc = npc_info(npc) })
end

function on_item_take(obj)
	if obj and props[obj:id()] then next_props_check = 0; return end  -- a «Шари Суслова» or «Анекдот» prop: it goes back
	if not db.actor or not obj or not isArtefact(obj) then return end
	append_event({ type = "artifact", name = item_title(obj:section()) or obj:section() })
end

function on_actor_spawn()
	props, props_loaded = {}, false  -- read again from this save
	vovas, vovas_loaded = {}, false
	append_event({ type = "game_loaded" })
end

-- Safe wrappers for the hook lines in bind_stalker / xr_motivator
function safe(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then log_error(err) end
end
